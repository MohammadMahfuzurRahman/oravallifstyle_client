# Local MongoDB. For MongoDB Atlas, paste your mongodb+srv:// connection string here.
MONGODB_URI=mongodb://127.0.0.1:27017/oravel
MONGODB_DB=oravel
AUTH_SECRET=put-a-long-random-string-here
# Admin account created by "npm run seed". CHANGE THE PASSWORD before going live.
ADMIN_EMAIL=admin@oravel.com
ADMIN_PASSWORD=ChangeMe12345
# WhatsApp number, international format without + (example 8801XXXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=
